# Local development only. Never commit credentials or the generated .env.
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
WORKSPACE_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# For direct host development. Compose supplies its internal PostgreSQL URL.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/flowvia
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
SEED_DEMO_DATA=true

# Dry runs use deterministic sample replies and never call paid AI or send messages.
# Real Telegram/OpenRouter credentials are entered by the owner through the UI.
OUTBOUND_MODE=dry_run
WORKER_POLL_SECONDS=0.5

# Local: leave empty to create a private key in the shared credential_data volume.
# Production: set an explicit Fernet key, disable demo seed and enable secure cookies.
# Back up the encryption key together with the database. Do not rotate it in place.
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_FILE=.data/credential.key

# Optional extras profile; file intake is not implemented yet.
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=flowvia-local
OBJECT_STORAGE_ACCESS_KEY=change_me
OBJECT_STORAGE_SECRET_KEY=change_me_too
