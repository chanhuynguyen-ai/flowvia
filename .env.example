# Development-only values. Never commit real credentials.
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
WORKSPACE_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Direct host development. Docker Compose overrides the DB/Redis/MinIO hostnames.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/flowvia
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=flowvia-local
OBJECT_STORAGE_ACCESS_KEY=change_me
OBJECT_STORAGE_SECRET_KEY=change_me_too

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
# Local development only. Keep false outside the local demo environment.
SEED_DEMO_DATA=true

AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/connections/gmail/callback

# Reserved for later credential/session hardening. Generate outside Git.
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

OUTBOUND_MODE=dry_run
MAX_WORKFLOW_NODES=50
MAX_UPLOAD_BYTES=20971520
